.create function $TABLE$SCOPEEligible(contract:string,store:string,$RESOURCE_ARGcaptured_from:datetime,asof:datetime) {
let Membership=CulpritPublished$SCOPEV1(contract,store,$RESOURCE_VALUEcaptured_from,asof)
    | mv-expand Batch=Batches
    | where tostring(Batch.table) == "$TABLE" and tobool(Batch.delivery_required)
    | project RangeId,$RESOURCE_MEMBERSHIP BatchId=tostring(Batch.batch_id), ExpectedRows=tolong(Batch.rows),
        PublishedKind=ResourceKind, PublishedManifest=ManifestSha256, PublishedSchema=SchemaDigest, PublishedOutbox=OutboxId,
        PublishedEpoch=OwnerEpoch, PublishedSequence=CaptureSequence, PublishedReferencesComplete=ReferencesComplete;
    $TABLE
    | where ContractId == contract and $RESOURCE_FILTER
    | where CollectedUntil >= captured_from and CollectedUntil <= asof
    | project $PROJECTION
    | distinct $COLUMNS
    | join kind=leftouter Membership on RangeId, BatchId
    | order by RangeId asc, BatchId asc, RowOrdinal asc nulls first
    | extend CulpritRow=row_number()
    | extend CulpritRangeStart=CulpritRow == 1 or RangeId != prev(RangeId),
        CulpritBatchStart=CulpritRow == 1 or RangeId != prev(RangeId) or BatchId != prev(BatchId)
    | extend CulpritBatchOrd=row_number(1, CulpritBatchStart),
        CulpritSameOrdinal=not(CulpritBatchStart) and ((isnull(RowOrdinal) and isnull(prev(RowOrdinal))) or (isnotnull(RowOrdinal) and RowOrdinal == prev(RowOrdinal))),
        CulpritInvalidRow=isnull(ExpectedRows) or isnull(RowOrdinal) or RowOrdinal <= 0 or RowOrdinal > ExpectedRows
            or ResourceKind != PublishedKind or ManifestSha256 != PublishedManifest or SchemaDigest != PublishedSchema
            or OutboxId != PublishedOutbox or OwnerEpoch != PublishedEpoch or CaptureSequence != PublishedSequence
            or ReferencesComplete != PublishedReferencesComplete$RESOURCE_MISMATCH
    | extend Variants=iff(CulpritSameOrdinal, 2, 1)
    | extend CulpritBadAsc=row_cumsum(iff(Variants != 1 or CulpritInvalidRow, 1, 0), CulpritRangeStart)
    | order by RangeId desc, BatchId desc, CulpritBatchOrd desc
    | extend CulpritRevRow=row_number()
    | extend CulpritRangeEnd=CulpritRevRow == 1 or RangeId != prev(RangeId),
        CulpritBatchEnd=CulpritRevRow == 1 or RangeId != prev(RangeId) or BatchId != prev(BatchId)
    | extend CulpritBatchDesc=row_number(1, CulpritBatchEnd),
        CulpritBadDesc=row_cumsum(iff(Variants != 1 or CulpritInvalidRow, 1, 0), CulpritRangeEnd)
    | extend PresentRows=CulpritBatchOrd + CulpritBatchDesc - 1
    | where CulpritBadAsc == 0 and CulpritBadDesc == 0 and PresentRows == ExpectedRows
    | project $COLUMNS
$RESTORE
}
