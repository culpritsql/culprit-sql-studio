{
  "pipeline": "database-telemetry",
  "shard": "pilot",
  "workspace": "/var/lib/culprit/workspace",
  "state": "/var/lib/culprit/state",
  "health_listen": "0.0.0.0:9098",
  "inventory": {
    "targets": [
      {
        "id": "pilot-database",
        "connection": "pilot",
        "subject": {
          "kind": "database"
        },
        "shard": "pilot",
        "admission_group": "REPLACE_PHYSICAL_RESOURCE_GROUP"
      }
    ]
  },
  "recovery": {
    "provider": "azure-blob",
    "options": {
      "account": "REPLACE_STORAGE_ACCOUNT",
      "container": "culprit-native",
      "prefix": "database-telemetry/pilot"
    },
    "credential": "recovery"
  },
  "target": {
    "kind": "adx",
    "query": {
      "endpoint": "https://REPLACE_CLUSTER.REGION.kusto.windows.net",
      "database": "REPLACE_ADX_DATABASE"
    },
    "credential": "analytics",
    "delivery": {
      "credential": "ingestion"
    }
  },
  "limits": {
    "max_bytes": 1073741824,
    "max_captures": 256
  },
  "credentials": {
    "source": {
      "kind": "azure",
      "identity": {
        "kind": "workload-identity",
        "tenant_id": "REPLACE_TENANT_ID",
        "client_id": "REPLACE_SOURCE_CLIENT_ID",
        "token_file": "/var/run/secrets/culprit/token"
      }
    },
    "recovery": {
      "kind": "azure",
      "identity": {
        "kind": "workload-identity",
        "tenant_id": "REPLACE_TENANT_ID",
        "client_id": "REPLACE_RECOVERY_CLIENT_ID",
        "token_file": "/var/run/secrets/culprit/token"
      }
    },
    "analytics": {
      "kind": "azure",
      "identity": {
        "kind": "workload-identity",
        "tenant_id": "REPLACE_TENANT_ID",
        "client_id": "REPLACE_ANALYTICS_CLIENT_ID",
        "token_file": "/var/run/secrets/culprit/token"
      }
    },
    "ingestion": {
      "kind": "azure",
      "identity": {
        "kind": "workload-identity",
        "tenant_id": "REPLACE_TENANT_ID",
        "client_id": "REPLACE_INGESTION_CLIENT_ID",
        "token_file": "/var/run/secrets/culprit/token"
      }
    }
  },
  "source_credentials": {
    "pilot": "source"
  },
  "monitoring": {
    "kind": "standard",
    "budget": {
      "page_rows": 250,
      "max_snapshot_rows": 500,
      "page_bytes": 4194304,
      "total_bytes": 67108864,
      "max_sql_bytes": 262144,
      "max_plan_bytes": 2097152,
      "max_pages": 32,
      "max_queries": 128,
      "statement_timeout_ms": 3000,
      "total_timeout_ms": 15000
    }
  }
}
