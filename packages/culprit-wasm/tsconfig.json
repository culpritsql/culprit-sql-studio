{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "rootDir": "src",
    "rootDirs": ["src", "pkg"],
    "outDir": "pkg",
    "types": [],
    "verbatimModuleSyntax": true,
    "noEmitOnError": true
  },
  "include": ["src/index.ts"]
}
